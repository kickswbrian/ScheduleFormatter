{
  "manifest_version": 3,
  "name": "NYU Albert Course Organizer",
  "version": "2.0",
  "description": "Auto-shows a live schedule panel on NYU Albert course listing pages.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://sis.portal.nyu.edu/*"],
  "action": {
    "default_title": "Toggle NYU Organizer Panel",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://sis.portal.nyu.edu/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
