{
  "manifest_version": 3,
  "name": "NYU Albert Course Organizer",
  "version": "1.0",
  "description": "Click the icon on any Albert course listing to see sections sorted by day and time with filters.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://sis.portal.nyu.edu/*"],
  "action": {
    "default_title": "Organize Albert Courses",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
